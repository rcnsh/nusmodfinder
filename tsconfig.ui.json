{
  // The Playwright specs: Node drives them, and the callbacks they
  // hand to page.evaluate run in the page, so they get the DOM lib as well.
  // scripts/live-check.mjs and live-shortlist.mjs (the live checks) drive the live page the same way.
  "extends": "./tsconfig.node.json",
  "compilerOptions": { "lib": ["es2023", "dom", "dom.iterable"] },
  "include": ["test/ui/**/*.spec.js", "test/ui/**/*.mjs", "scripts/live-check.mjs", "scripts/live-shortlist.mjs", "scripts/corpus-types.d.ts"],
  "exclude": []
}
