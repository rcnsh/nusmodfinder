{
  // Node side: scripts/ and tool configs. checkJs is off so the pre-Phase-0
  // scripts (eval, ingest, judge, ...) are not checked until they are typed;
  // files opt in with `// @ts-check`.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // The wrangler/Vitest aliases src/intent-data.js and src/group-data.js
    // import (Phase 5 5B), typed as the production files they default to.
    "paths": { "vocabulary-data": ["./data/vocabulary.json"], "groups-data": ["./data/groups.json"], "ng-unscheduled-data": ["./data/ng-unscheduled.json"] }
  },
  "include": ["scripts/**/*.mjs", "eval/**/*.mjs", "*.mjs", "scripts/corpus-types.d.ts", "eval/runner/types.d.ts", "test/**/*.node.test.js", "test/**/*.node.mjs"],
  "exclude": ["eval/v1/**", "scripts/p5-live.mjs"]
}
