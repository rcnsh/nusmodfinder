{
  // Worker side: src/ and the tests that run inside workerd. Node-side
  // scripts and configs are checked by tsconfig.node.json.
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["@cloudflare/vitest-plugin/types"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // The wrangler/Vitest aliases src/intent-data.js and src/group-data.js
    // import (Phase 5 5B), typed as the production files they default to.
    "paths": { "vocabulary-data": ["./data/vocabulary.json"], "groups-data": ["./data/groups.json"], "ng-unscheduled-data": ["./data/ng-unscheduled.json"] }
  },
  "include": ["worker-configuration.d.ts", "scripts/corpus-types.d.ts", "src/**/*", "test/**/*", "eval/runner/**/*.js", "eval/runner/types.d.ts", "eval/runner/vitest.d.ts"],
  "exclude": ["test/fixtures/**", "test/**/*.node.test.js", "test/**/*.node.mjs", "test/ui/**/*.spec.js", "test/ui/**/*.mjs"]
}
