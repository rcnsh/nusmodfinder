{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nusmodfinder",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The public address (ADR 0009). A Custom Domain: Cloudflare makes the DNS
  // record and certificate on rcn.sh. `npm run deploy` applies it with
  // `wrangler triggers deploy` after promoting, since `versions deploy` does
  // not touch routes. The workers.dev URL is off (Jacob, ADR 0009): the
  // Custom Domain is the only address.
  "routes": [{ "pattern": "nusmodfinder.rcn.sh", "custom_domain": true }],
  "workers_dev": false,

  // The page (Phase 5 5B): public/ as Workers Static Assets. No binding, so
  // Env gains nothing, and a request for a file there (`/`, `/app.js`) is
  // answered without running the Worker or spending its CPU; every other path,
  // the API included, reaches the Worker. Asset responses carry no
  // x-app-version: GET /health is the version trace for the page.
  "assets": { "directory": "./public" },

  // The bundled corpus vectors (src/dense.js, Phase 3 3-0). Defaults to the
  // committed fixture, so a fresh checkout, `wrangler dev` and CI build
  // without the 10 MB production bundle. `npm run deploy` overrides it with
  // --alias to the sha-checked production bundle and refuses the fixture and
  // the pinned bundle; a plain `wrangler deploy` would ship the fixture.
  // An alias to a .bin file directly is not collected as a Data module, so it
  // points at a two-line module that imports one.
  //
  // 3C's vocabulary and 3F's groups (src/intent-data.js, src/group-data.js) are
  // bare names too (Phase 5 5B, A2-1), so the UI test config can point them at
  // the fixture's: esbuild accepts no relative alias keys. Wrangler merges these
  // with deploy's --alias, so the deploy adds none for them. 6A's NG-listed
  // codes with no classes (src/ng-unscheduled.js) are one more, built with the
  // groups (scripts/build-ng-unscheduled.mjs). Phase 7 7D's catalogue codes and
  // prefixes (src/intent-data.js) follow the corpus too: built from `current`
  // (data/corpus.json) by scripts/build-3b-data.mjs --corpus production; the
  // deploy guard checks D1's catalogue_only against the catalogue file.
  "alias": {
    "vectors-bundle": "./test/fixtures/vectors.js",
    "vocabulary-data": "./data/vocabulary.json",
    "groups-data": "./data/groups.json",
    "ng-unscheduled-data": "./data/ng-unscheduled.json",
    "catalogue-codes-data": "./data/catalogue-codes.json",
    "prefixes-data": "./data/prefixes.json"
  },

  "d1_databases": [
    {
      "binding": "DB",
      // APAC primary (ADR 0005).
      "database_name": "nusmods-apac",
      "database_id": "de4527ff-19ec-4a5b-9c5c-4d1791078b25"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "nusmods-modules"
    }
  ],
  "ai": { "binding": "AI" },

  // Which Worker version is serving: returned as `x-app-version` and by
  // GET /health. `npm run deploy` tags each version with its commit SHA.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Which dense retriever /search uses: "bundle" (exact search over the
  // bundled vectors) or "vectorize" (the cold standby, degraded service;
  // docs/plans/phase3.md 3-0, B3-6). Flipped by a deploy; every deploy gets a
  // new version id, which is in the /search cache key.
  "vars": { "DENSE_BACKEND": "bundle" },

  // /search costs a Workers AI embedding and a Vectorize query per request.
  // The guardrail lives in the Worker. It predates the Custom Domain, when
  // workers.dev was the only address and no zone rate-limiting rule applied.
  //
  // Two per-IP limits (Phase 8 8B, ADR 0012 G5 (b)), both asked before any
  // other binding: 40 per 10 s lets a class behind one address search, and
  // 200 per 60 s caps a script that stays just under the burst limit.
  //
  // They are BURST guards, not a budget guard. Each binding is per-IP AND
  // per-colo, and Cloudflare documents its counters as permissive and
  // eventually consistent: a measured burst of 80 requests in 2s passed
  // untouched before the counter caught up. They stop a runaway script; they
  // do NOT protect the account-wide monthly allowances against traffic spread
  // over many addresses, which stays an accepted residual risk (see
  // docs/REFERENCE.md).
  "ratelimits": [
    {
      "name": "SEARCH_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 40, "period": 10 }
    },
    {
      "name": "SEARCH_LIMIT_MINUTE",
      "namespace_id": "1002",
      "simple": { "limit": 200, "period": 60 }
    }
  ]
}
