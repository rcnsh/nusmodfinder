{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vector-nusmods",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],

  "d1_databases": [
    {
      "binding": "DB",
      // APAC primary (ADR 0005).
      "database_name": "nusmods-apac",
      "database_id": "de4527ff-19ec-4a5b-9c5c-4d1791078b25"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "nusmods-modules"
    }
  ],
  "ai": { "binding": "AI" },

  // Which Worker version is serving: returned as `x-app-version` and by
  // GET /health. `npm run deploy` tags each version with its commit SHA.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // /search costs a Workers AI embedding and a Vectorize query per request. A
  // Cloudflare rate-limiting RULE is not an option here — workers.dev is not a
  // zone the account controls — so the guardrail lives in the Worker.
  //
  // This is a BURST guard, not a budget guard. The binding is per-IP AND
  // per-colo, and Cloudflare documents its counters as permissive and
  // eventually consistent: a measured burst of 80 requests in 2s passed
  // untouched before the counter caught up. It stops a runaway script; it does
  // NOT protect the account-wide monthly Vectorize allowance, which stays an
  // accepted residual risk (see README).
  "ratelimits": [
    {
      "name": "SEARCH_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 10 }
    }
  ]
}
