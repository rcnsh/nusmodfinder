{
  "name": "vector-nusmods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Semantic module search over NUSMods, on Cloudflare Workers + Vectorize + D1.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "probe": "node scripts/probe.mjs",
    "ingest": "node scripts/ingest.mjs",
    "verify": "node scripts/verify.mjs",
    "eval": "node eval/cli.mjs run",
    "eval:report": "node eval/cli.mjs report",
    "eval:pool": "node eval/cli.mjs pool",
    "eval:judge": "node eval/judge.mjs",
    "eval:embed": "node scripts/embed.mjs",
    "eval:verify": "node scripts/holdout.mjs verify",
    "eval:count": "node eval/count.mjs",
    "eval:groups": "node eval/groups.mjs",
    "eval:representatives": "node eval/representatives.mjs",
    "test:eval": "node eval/selftest.mjs",
    "dev": "node scripts/ui-server.mjs",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.ui.json",
    "test": "vitest run --exclude 'test/full/**' --exclude 'test/sc1/**'",
    "test:full": "vitest run test/full",
    "test:sc1": "vitest run --project sc1",
    "test:ui": "playwright test",
    "db:rebuild-check": "node scripts/schema-snapshot.mjs",
    "check:findings": "node scripts/check-findings.mjs",
    "contrast": "node scripts/contrast.mjs",
    "types": "wrangler types --env-file .dev.vars.example",
    "types:check": "wrangler types --env-file .dev.vars.example && git diff --exit-code -- worker-configuration.d.ts",
    "fixture": "node scripts/build-fixture.mjs",
    "eval:phrases": "node eval/phrases.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.5.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "acorn": "8.19.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
