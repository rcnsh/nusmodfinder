{
  "name": "vector-nusmods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Semantic module search over NUSMods, on Cloudflare Workers + Vectorize + D1.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "probe": "node scripts/probe.mjs",
    "ingest": "node scripts/ingest.mjs",
    "eval": "node scripts/eval.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run --exclude 'test/full/**'",
    "test:full": "vitest run test/full",
    "db:rebuild-check": "node scripts/schema-snapshot.mjs",
    "types": "wrangler types --env-file .dev.vars.example",
    "types:check": "wrangler types --env-file .dev.vars.example && git diff --exit-code -- worker-configuration.d.ts",
    "fixture": "node scripts/build-fixture.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
