  "master": [
    "{\"name\":\"catalogue_only\",\"sql\":\"CREATE TABLE catalogue_only ( code TEXT PRIMARY KEY, title TEXT NOT NULL, description TEXT, acad_year TEXT NOT NULL, row_hash TEXT NOT NULL )\",\"tbl_name\":\"catalogue_only\",\"type\":\"table\"}",
    "{\"name\":\"idx_modules_credits\",\"sql\":\"CREATE INDEX idx_modules_credits ON modules(credits)\",\"tbl_name\":\"modules\",\"type\":\"index\"}",
    "{\"name\":\"idx_modules_faculty\",\"sql\":\"CREATE INDEX idx_modules_faculty ON modules(faculty)\",\"tbl_name\":\"modules\",\"type\":\"index\"}",
    "{\"name\":\"idx_modules_level\",\"sql\":\"CREATE INDEX idx_modules_level ON modules(level)\",\"tbl_name\":\"modules\",\"type\":\"index\"}",
    "{\"name\":\"idx_modules_ng\",\"sql\":\"CREATE INDEX idx_modules_ng ON modules(ng)\",\"tbl_name\":\"modules\",\"type\":\"index\"}",
    "{\"name\":\"idx_modules_sem3\",\"sql\":\"CREATE INDEX idx_modules_sem3 ON modules(sem3) WHERE sem3 = 1\",\"tbl_name\":\"modules\",\"type\":\"index\"}",
    "{\"name\":\"idx_modules_sem4\",\"sql\":\"CREATE INDEX idx_modules_sem4 ON modules(sem4) WHERE sem4 = 1\",\"tbl_name\":\"modules\",\"type\":\"index\"}",
    "{\"name\":\"meta\",\"sql\":\"CREATE TABLE meta ( key TEXT PRIMARY KEY, value TEXT NOT NULL, updated_at TEXT NOT NULL )\",\"tbl_name\":\"meta\",\"type\":\"table\"}",
    "{\"name\":\"modules\",\"sql\":\"CREATE TABLE modules ( code TEXT PRIMARY KEY, title TEXT NOT NULL, description TEXT, credits REAL, department TEXT, faculty TEXT, level INTEGER, semesters TEXT, workload TEXT, prerequisite TEXT, preclusion TEXT, acad_year TEXT NOT NULL, text_hash TEXT NOT NULL , ng INTEGER NOT NULL DEFAULT 0, ng_semesters TEXT, sem1 INTEGER GENERATED ALWAYS AS (instr(replace(replace(coalesce(semesters, ''), '[', ','), ']', ','), ',1,') > 0) VIRTUAL, sem2 INTEGER GENERATED ALWAYS AS (instr(replace(replace(coalesce(semesters, ''), '[', ','), ']', ','), ',2,') > 0) VIRTUAL, sem3 INTEGER GENERATED ALWAYS AS (instr(replace(replace(coalesce(semesters, ''), '[', ','), ']', ','), ',3,') > 0) VIRTUAL, sem4 INTEGER GENERATED ALWAYS AS (instr(replace(replace(coalesce(semesters, ''), '[', ','), ']', ','), ',4,') > 0) VIRTUAL, ng_sem1 INTEGER GENERATED ALWAYS AS (instr(replace(replace(coalesce(ng_semesters, ''), '[', ','), ']', ','), ',1,') > 0) VIRTUAL, ng_sem2 INTEGER GENERATED ALWAYS AS (instr(replace(replace(coalesce(ng_semesters, ''), '[', ','), ']', ','), ',2,') > 0) VIRTUAL, row_hash TEXT, exam_semesters TEXT NOT NULL DEFAULT '[]', exam_sem1 INTEGER GENERATED ALWAYS AS (instr(exam_semesters, '1') > 0) VIRTUAL, exam_sem2 INTEGER GENERATED ALWAYS AS (instr(exam_semesters, '2') > 0) VIRTUAL, exam_sem3 INTEGER GENERATED ALWAYS AS (instr(exam_semesters, '3') > 0) VIRTUAL, exam_sem4 INTEGER GENERATED ALWAYS AS (instr(exam_semesters, '4') > 0) VIRTUAL, su INTEGER NOT NULL DEFAULT 0, grading_basis TEXT, workload_hours REAL, prereq_none INTEGER NOT NULL DEFAULT 0, prereq_cohort_only INTEGER NOT NULL DEFAULT 0, ng_allow INTEGER NOT NULL DEFAULT 0, ng_rules TEXT, exam_dates TEXT NOT NULL DEFAULT '[]')\",\"tbl_name\":\"modules\",\"type\":\"table\"}",
    "{\"name\":\"modules_fts\",\"sql\":\"CREATE VIRTUAL TABLE modules_fts USING fts5( code UNINDEXED, title, description, content = 'modules', content_rowid = 'rowid', tokenize = 'porter unicode61', prefix = '2 3 4' )\",\"tbl_name\":\"modules_fts\",\"type\":\"table\"}",
    "{\"name\":\"modules_fts_config\",\"sql\":\"CREATE TABLE 'modules_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID\",\"tbl_name\":\"modules_fts_config\",\"type\":\"table\"}",
    "{\"name\":\"modules_fts_data\",\"sql\":\"CREATE TABLE 'modules_fts_data'(id INTEGER PRIMARY KEY, block BLOB)\",\"tbl_name\":\"modules_fts_data\",\"type\":\"table\"}",
    "{\"name\":\"modules_fts_delete\",\"sql\":\"CREATE TRIGGER modules_fts_delete AFTER DELETE ON modules BEGIN INSERT INTO modules_fts(modules_fts, rowid, code, title, description) VALUES ('delete', old.rowid, old.code, old.title, old.description); END\",\"tbl_name\":\"modules\",\"type\":\"trigger\"}",
    "{\"name\":\"modules_fts_docsize\",\"sql\":\"CREATE TABLE 'modules_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB)\",\"tbl_name\":\"modules_fts_docsize\",\"type\":\"table\"}",
    "{\"name\":\"modules_fts_idx\",\"sql\":\"CREATE TABLE 'modules_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID\",\"tbl_name\":\"modules_fts_idx\",\"type\":\"table\"}",
    "{\"name\":\"modules_fts_insert\",\"sql\":\"CREATE TRIGGER modules_fts_insert AFTER INSERT ON modules BEGIN INSERT INTO modules_fts(rowid, code, title, description) VALUES (new.rowid, new.code, new.title, new.description); END\",\"tbl_name\":\"modules\",\"type\":\"trigger\"}",
    "{\"name\":\"modules_fts_update\",\"sql\":\"CREATE TRIGGER modules_fts_update AFTER UPDATE OF code, title, description ON modules WHEN old.title IS NOT new.title OR old.description IS NOT new.description OR old.code IS NOT new.code BEGIN INSERT INTO modules_fts(modules_fts, rowid, code, title, description) VALUES ('delete', old.rowid, old.code, old.title, old.description); INSERT INTO modules_fts(rowid, code, title, description) VALUES (new.rowid, new.code, new.title, new.description); END\",\"tbl_name\":\"modules\",\"type\":\"trigger\"}",
    "{\"name\":\"modules_rowid_immutable\",\"sql\":\"CREATE TRIGGER modules_rowid_immutable AFTER UPDATE ON modules WHEN new.rowid IS NOT old.rowid BEGIN SELECT RAISE(ABORT, 'modules.rowid is immutable: modules_fts is keyed on it'); END\",\"tbl_name\":\"modules\",\"type\":\"trigger\"}"
  ],
